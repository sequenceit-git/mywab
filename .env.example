# Local MongoDB on the VPS (Docker service `mongo`)
# docker compose overrides this to mongodb://mongo:27017/wapbusiness
MONGODB_URI=mongodb://127.0.0.1:27017/wapbusiness

# WhatsApp Business Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=verify_token

# Telegram Worker Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WORKER_GROUP_ID=-1001234567890

# App & Traefik Domain Configuration
NEXT_PUBLIC_APP_URL=https://dsdukan.cloud
DOMAIN=dsdukan.cloud
# Must match Traefik's Docker network: docker inspect traefik-alro-traefik-1 --format '{{range $k,$v := .NetworkSettings.Networks}}{{println $k}}{{end}}'
TRAEFIK_NETWORK=traefik-alro_default
CERT_RESOLVER=letsencrypt

# Admin Authentication Panel Credentials
ADMIN_EMAIL=admin@dsdukan.cloud
ADMIN_PASSWORD=your-secure-password
AUTH_SECRET=your-random-secret

# Kokos Activator API (PUBG Mobile UC Auto-Fulfillment)
# Get your token from Telegram bot: https://t.me/kokos_activator_bot (send /api)
KOKOS_API_TOKEN=your-kokos-api-token

# Pinex API (Free Fire Diamonds & Shells Auto-Fulfillment)
# Endpoint: https://sohan.pinexbot.shop/pinex/brand
PINEX_API_KEY="your api key"
PINEX_API_URL="https://example.pinexbot.shop/pinex/brand"

# ZiniPay Payment Gateway API Configuration (Auto Payment Verification)
# Base URL: https://api.zinipay.com
ZINIPAY_API_KEY=sandbox_test_8f4c9a2e7b31
ZINIPAY_API_URL=https://api.zinipay.com
